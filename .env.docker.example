# Compose production-like container. Copy to .env.docker and keep preview mode locally.
HTTPS_PORT=3443
IMAGE_TAG=local

# Public values are also passed as Docker build arguments.
NEXT_PUBLIC_SITE_URL=https://localhost:3443
ALLOWED_ORIGIN=https://localhost:3443
SITE_MODE=preview
CONTENT_APPROVED=false

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=staging
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
SANITY_API_READ_TOKEN=

RESEND_API_KEY=
LEADS_TO_EMAIL=
RESEND_FROM_EMAIL=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
