# URL pública canónica. Este valor seguro funciona al copiar el archivo para desarrollo.
NEXT_PUBLIC_SITE_URL=https://localhost:3000
# Origen exacto permitido para POST /api/contact en desarrollo.
ALLOWED_ORIGIN=https://localhost:3000
# Usar "preview" hasta tener contenido, revisión legal y checklist aprobados.
SITE_MODE=preview
# Cambiar a true sólo con contenido profesional y legal formalmente aprobado.
CONTENT_APPROVED=false

# Sanity: valores de sanity.io/manage. El token es sólo de lectura y sólo del servidor.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01
SANITY_API_READ_TOKEN=

# Resend: clave secreta, buzón receptor y remitente de un dominio verificado.
RESEND_API_KEY=
LEADS_TO_EMAIL=
RESEND_FROM_EMAIL=

# Cloudflare Turnstile. Estas credenciales oficiales sólo sirven para Development y
# siempre pasan; Production debe usar un widget real restringido al dominio canónico.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Identificadores públicos; las etiquetas sólo se activarán después del consentimiento.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
