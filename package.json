{
  "name": "maykit-psicologia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev --hostname localhost --experimental-https --experimental-https-key certs/local/localhost-key.pem --experimental-https-cert certs/local/localhost.pem",
