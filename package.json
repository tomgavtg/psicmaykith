    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@sanity/image-url": "2.1.1",
    "@sanity/client": "7.26.0",
    "next": "16.2.12",
